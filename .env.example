# Runtime: the UI is intentionally loopback-only.
HOST=127.0.0.1
PORT=3000

# managed: this app starts and owns a loopback Hermes child process.
# external: connect to an already-running Hermes gateway/API.
HERMES_BACKEND_MODE=managed
HERMES_COMMAND=hermes

# External WebSocket gateway. Leave unset in managed mode.
HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
HERMES_WS_TOKEN=

# Optional HTTP fallback (Runs/SSE, Responses, then Chat Completions when
# advertised by the connected backend). Leave credentials empty unless the
# external server requires them. These values stay server-side.
HERMES_BASE_URL=http://127.0.0.1:9119
HERMES_API_KEY=

# Optional named Hermes profile. An empty value uses the Hermes default.
HERMES_PROFILE=

# Live smoke safety. Keep billing and remote targets opt-in.
# HERMES_SMOKE_ALLOW_BILLING=0
# HERMES_SMOKE_UI_URL=http://127.0.0.1:3040
# HERMES_SMOKE_DIRECT=0
# HERMES_SMOKE_ALLOW_REMOTE=0
# HERMES_SMOKE_EXPECT_VERSION=0.18.2
# HERMES_SMOKE_EXPECT_MODEL=gpt-5.6-sol
# HERMES_SMOKE_EXPECT_PROVIDER=openai-codex
